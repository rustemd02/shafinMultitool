{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://set-os.local/datasets/camera-coach/v1/temporal-schema.json",
  "schema_version": "v1.0.0",
  "title": "Camera Coach temporal sequence record v1",
  "description": "Temporal extension of the shared Camera Coach label contract. A sequence is one take/family and is never partitioned frame-by-frame; frame_id values are unique within each sequence and across all temporal records in one admitted batch (batch scope enforced by the validator).",
  "allOf": [
    {"$ref": "label-schema.json"},
    {
      "type": "object",
      "required": ["schema_id", "record_type", "sequence"],
      "properties": {
        "schema_id": {"const": "camera-temporal-v1"},
        "record_type": {"const": "temporal"},
        "capture": {"type": "object", "properties": {"capture_mode": {"const": "temporal_sequence"}}},
        "sequence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence_id", "frame_count", "frames", "timeline"],
          "properties": {
            "sequence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
            "frame_count": {"type": "integer", "minimum": 2},
            "frames": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["frame_id", "ordinal", "timestamp_ms", "asset_id", "state"],
                "properties": {
                  "frame_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
                  "ordinal": {"type": "integer", "minimum": 0},
                  "timestamp_ms": {"type": "integer", "minimum": 0},
                  "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
                  "state": {"enum": ["acquire", "stable", "moving", "rotation", "lens_change", "lighting_transition", "scene_cut", "unknown"]}
                }
              }
            },
            "timeline": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "start_frame", "end_frame"],
                "properties": {
                  "state": {"enum": ["acquire", "stable", "moving", "rotation", "lens_change", "lighting_transition", "scene_cut", "unknown"]},
                  "start_frame": {"type": "integer", "minimum": 0},
                  "end_frame": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        }
      }
    }
  ]
}
