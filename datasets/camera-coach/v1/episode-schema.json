{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://set-os.local/datasets/camera-coach/v1/episode-schema.json",
  "schema_version": "v1.0.0",
  "title": "Camera Coach before/after episode record v1",
  "description": "Before/action/after extension of the shared Camera Coach label contract. Outcomes are explicit and do not imply model quality.",
  "allOf": [
    {"$ref": "label-schema.json"},
    {
      "type": "object",
      "required": ["schema_id", "record_type", "episode"],
      "properties": {
        "schema_id": {"const": "camera-episode-v1"},
        "record_type": {"const": "episode"},
        "capture": {"type": "object", "properties": {"capture_mode": {"const": "before_after_episode"}}},
        "episode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["episode_id", "before", "action_step", "after", "outcome", "outcome_verifier", "subject_continuity"],
          "properties": {
            "episode_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
            "before": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_id", "captured_at"],
              "properties": {
                "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
                "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
              }
            },
            "action_step": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action_id", "performed_at"],
              "properties": {
                "action_id": {"$ref": "label-schema.json#/$defs/actionId"},
                "performed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
              }
            },
            "after": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_id", "captured_at"],
              "properties": {
                "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
                "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
              }
            },
            "outcome": {"enum": ["correct", "no_op", "opposite", "overshoot", "track_loss", "incomparable"]},
            "outcome_verifier": {"$ref": "label-schema.json#/$defs/verifierId"},
            "subject_continuity": {"enum": ["same", "changed", "lost", "unknown"]}
          }
        }
      }
    }
  ]
}
