{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://set-os.local/schemas/scene-annotation-v1.schema.json",
  "title": "SET OS Scene Generator annotation record v1",
  "description": "An append-only annotation record for SceneScript candidates, acceptable alternatives, clarification and forbidden-hallucination decisions. Rights disposition remains in M3-024 manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_id",
    "sample_id",
    "locale",
    "source_text",
    "scene_boundaries",
    "marked_objects",
    "candidates",
    "acceptable_variants",
    "forbidden_hallucinations",
    "gold",
    "votes",
    "review_history"
  ],
  "properties": {
    "schema_version": { "const": "scene-annotation-v1" },
    "annotation_id": { "$ref": "scene-contract-v1.schema.json#/$defs/identifier" },
    "sample_id": { "$ref": "scene-contract-v1.schema.json#/$defs/identifier" },
    "locale": { "$ref": "scene-contract-v1.schema.json#/$defs/locale" },
    "source_text": { "$ref": "scene-contract-v1.schema.json#/$defs/text" },
    "scene_boundaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "scene-contract-v1.schema.json#/$defs/scene_boundary" }
    },
    "marked_objects": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "scene-contract-v1.schema.json#/$defs/marked_object" }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "scene-contract-v1.schema.json#/$defs/candidate" }
    },
    "acceptable_variants": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "scene-contract-v1.schema.json#/$defs/acceptable_variant" }
    },
    "forbidden_hallucinations": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "scene-contract-v1.schema.json#/$defs/forbidden_hallucination" }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_candidate_id", "acceptable_variant_ids"],
      "properties": {
        "primary_candidate_id": { "$ref": "scene-contract-v1.schema.json#/$defs/identifier" },
        "acceptable_variant_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "scene-contract-v1.schema.json#/$defs/identifier" }
        }
      }
    },
    "votes": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "scene-contract-v1.schema.json#/$defs/vote" }
    },
    "review_history": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "scene-contract-v1.schema.json#/$defs/review_event" }
    }
  }
}
