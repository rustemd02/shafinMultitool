{
  "sourceLanguage": "en",
  "strings": {
    "set.generator.transfer.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send scene"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка сцены"
          }
        }
      }
    },
    "set.generator.transfer.question": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this text and the selected object references for this generation?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить этот текст и ссылки на выбранные объекты для этой генерации?"
          }
        }
      }
    },
    "set.generator.transfer.send": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree and send"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласиться и отправить"
          }
        }
      }
    },
    "set.generator.transfer.decline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep on this device"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить на устройстве"
          }
        }
      }
    },
    "set.generator.transfer.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online generation is unavailable because the service has not supplied a complete privacy policy. Your text has not been sent. You can keep editing it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн-генерация недоступна: сервис не предоставил полную политику обработки данных. Текст не отправлен. Вы можете продолжить редактирование."
          }
        }
      }
    },
    "set.generator.transfer.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service and its AI provider receive the text below, references to selected objects and any clarification answers you submit for this request. The service also receives an installation identifier for authentication and usage limits. Camera images, recordings and AR maps are not part of this transfer. This choice applies to this generation only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис и его ИИ-провайдер получат текст ниже, ссылки на выбранные объекты и ответы на уточнения, которые вы отправите для этого запроса. Сервис также получит идентификатор установки для авторизации и ограничения использования. Изображения камеры, записи и AR-карты не входят в эту отправку. Выбор действует только для этой генерации."
          }
        }
      }
    },
    "set.generator.transfer.operator": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service operator"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оператор сервиса"
          }
        }
      }
    },
    "set.generator.transfer.service": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service address"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес сервиса"
          }
        }
      }
    },
    "set.generator.transfer.provider": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI provider"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ-провайдер"
          }
        }
      }
    },
    "set.generator.transfer.region": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing region"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регион обработки"
          }
        }
      }
    },
    "set.generator.transfer.contentRetention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene text and results"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст сцены и результаты"
          }
        }
      }
    },
    "set.generator.transfer.metadataRetention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request records"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи о запросах"
          }
        }
      }
    },
    "set.generator.transfer.securityRetention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation and security records"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи об установке и безопасности"
          }
        }
      }
    },
    "set.generator.transfer.spendRetention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage and cost records"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи об использовании и расходах"
          }
        }
      }
    },
    "set.generator.transfer.providerRetention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI provider retention"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранение у ИИ-провайдера"
          }
        }
      }
    },
    "set.generator.transfer.deletion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request deletion"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как запросить удаление"
          }
        }
      }
    },
    "set.generator.transfer.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Policy version"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия политики"
          }
        }
      }
    },
    "set.generator.transfer.readPolicy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the privacy policy"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитать политику конфиденциальности"
          }
        }
      }
    },
    "set.generator.transfer.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text to send"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляемый текст"
          }
        }
      }
    },
    "set.generator.transfer.objects": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected object references"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылок на выбранные объекты"
          }
        }
      }
    },
    "set.privacy.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & licenses"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватность и лицензии"
          }
        }
      }
    },
    "set.privacy.introduction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can read this page without allowing camera or microphone access. Opening it does not send a scene or grant permission."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта страница доступна без разрешения на камеру и микрофон. Её открытие не отправляет сцену и не даёт разрешений."
          }
        }
      }
    },
    "set.privacy.account.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account and tracking"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись и отслеживание"
          }
        }
      }
    },
    "set.privacy.account.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SET OS does not require an account. The app does not include advertising or track you across other apps and websites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SET OS не требует учётной записи. В приложении нет рекламы и отслеживания между другими приложениями и сайтами."
          }
        }
      }
    },
    "set.privacy.camera.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera and AR"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера и AR"
          }
        }
      }
    },
    "set.privacy.camera.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Coach analyses camera frames on this device. AR uses the camera and motion sensors to place the scene. These frames and AR maps are not included in a Scene Generator request."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Coach анализирует кадры на этом устройстве. AR использует камеру и датчики движения для размещения сцены. Кадры и карты AR не входят в запрос Scene Generator."
          }
        }
      }
    },
    "set.privacy.scenes.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene descriptions"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Описания сцен"
          }
        }
      }
    },
    "set.privacy.scenes.local": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server generation is not connected in this session. Scene descriptions are processed on this device. Saved projects remain in the app’s storage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверная генерация в этом сеансе не подключена. Описания сцен обрабатываются на устройстве. Сохранённые проекты остаются в хранилище приложения."
          }
        }
      }
    },
    "set.privacy.scenes.remote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server generation is connected in this session. A generation request can send the scene description, object references and clarification answers to the SET OS service and its AI provider. It does not include camera frames, recordings or AR maps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом сеансе подключена серверная генерация. Запрос может передавать описание сцены, ссылки на объекты и ответы на уточнения сервису SET OS и его поставщику ИИ. Кадры камеры, записи и карты AR в запрос не входят."
          }
        }
      }
    },
    "set.privacy.installation.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service access"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к сервису"
          }
        }
      }
    },
    "set.privacy.installation.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service uses Apple App Attest and an identifier for this installation to authenticate requests and enforce usage limits. Job identifiers and security records can link requests from the same installation. They are not an advertising identifier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис использует Apple App Attest и идентификатор этой установки для проверки запросов и ограничений использования. Идентификаторы заданий и записи безопасности могут связывать запросы одной установки. Это не рекламный идентификатор."
          }
        }
      }
    },
    "set.privacy.server_storage.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server storage"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранение на сервере"
          }
        }
      }
    },
    "set.privacy.server_storage.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service may temporarily store requests and results, and retain security and usage records separately. Storage by an external AI provider follows that provider’s terms. Deleting a project on this device does not itself delete a server request or copies you exported."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис может временно хранить запросы и результаты, а записи безопасности и использования — отдельно. Хранение у внешнего поставщика ИИ определяется его условиями. Удаление проекта на устройстве само по себе не удаляет серверный запрос и экспортированные копии."
          }
        }
      }
    },
    "set.privacy.microphone.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone and recordings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон и записи"
          }
        }
      }
    },
    "set.privacy.microphone.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used when you choose recording with sound, enable the sound-level meter or start spoken input. Video recording without sound does not use the microphone. The sound-level meter processes audio locally without saving an audio file. Saved recordings stay on the device unless you export or share them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон используется при выборе записи со звуком, включении измерителя уровня звука или голосового ввода. Запись видео без звука не использует микрофон. Измеритель обрабатывает звук локально и не сохраняет аудиофайл. Записи остаются на устройстве, пока вы не экспортируете их или не поделитесь ими."
          }
        }
      }
    },
    "set.privacy.speech.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoken input"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовой ввод"
          }
        }
      }
    },
    "set.privacy.speech.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoken scene input uses Apple Speech. Apple may process microphone audio on its servers. SET OS does not upload that audio to its Scene service. The recognized text becomes your editable scene description."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовой ввод сцены использует Apple Speech. Apple может обрабатывать звук микрофона на своих серверах. SET OS не отправляет этот звук своему сервису сцен. Распознанный текст становится редактируемым описанием сцены."
          }
        }
      }
    },
    "set.privacy.local_storage.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects and exported copies"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты и экспортированные копии"
          }
        }
      }
    },
    "set.privacy.local_storage.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects, AR maps and recordings are saved in the app’s storage. You can delete a saved project from the Library. Copies already saved to Photos or shared with another app are managed separately in those apps. Photos access is requested only when you choose to save a recording there."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты, карты AR и записи сохраняются в хранилище приложения. Сохранённый проект можно удалить из библиотеки. Копии, уже сохранённые в «Фото» или переданные другому приложению, управляются отдельно. Доступ к «Фото» запрашивается при выборе сохранения записи в медиатеку."
          }
        }
      }
    },
    "set.privacy.permissions.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your permissions"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши разрешения"
          }
        }
      }
    },
    "set.privacy.permissions.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera, microphone, speech recognition and Photos permissions can be changed in iOS Settings. Camera permission alone is not permission to send scene content to an AI service."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешения на камеру, микрофон, распознавание речи и «Фото» можно изменить в настройках iOS. Разрешение на камеру само по себе не разрешает передачу содержимого сцены сервису ИИ."
          }
        }
      }
    },
    "set.privacy.settings_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open Settings. Open this app’s page in iOS Settings to manage permissions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть настройки. Откройте страницу этого приложения в настройках iOS, чтобы изменить разрешения."
          }
        }
      }
    },
    "set.privacy.notices.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third-party notices"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лицензии компонентов"
          }
        }
      }
    },
    "set.privacy.notices.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a component below to read its full license and copyright notice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте компонент ниже, чтобы прочитать полный текст его лицензии и сведения об авторских правах."
          }
        }
      }
    },
    "set.privacy.notice_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The license text is unavailable in this copy of the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст лицензии недоступен в этой копии приложения."
          }
        }
      }
    },
    "set.privacy.notice_expanded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanded"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Развёрнуто"
          }
        }
      }
    },
    "set.privacy.notice_collapsed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapsed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свёрнуто"
          }
        }
      }
    },
    "set.cameraRecording.missingSamples": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some video or sound was skipped. Check the take before using it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть видео или звука пропущена. Проверьте дубль перед использованием."
          }
        }
      }
    },
    "set.cameraRecording.projectName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera take"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дубль камеры"
          }
        }
      }
    },
    "set.cameraRecording.storageUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open video storage. Retry preparing recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть хранилище видео. Повторите подготовку записи."
          }
        }
      }
    },
    "set.cameraRecording.retryPreparation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare recording again"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить подготовку записи"
          }
        }
      }
    },
    "set.cameraRecording.audioUnavailable": {
      "localizations": {
